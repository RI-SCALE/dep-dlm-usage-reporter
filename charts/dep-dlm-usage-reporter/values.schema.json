{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "schedule", "config"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "schedule": { "type": "string", "minLength": 9 },
    "timeZone": { "type": "string" },
    "suspend": { "type": "boolean" },
    "concurrencyPolicy": { "enum": ["Forbid", "Replace", "Allow"] },
    "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
    "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
    "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
    "backoffLimit": { "type": "integer", "minimum": 0 },
    "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "config": {
      "type": "object",
      "propertyNames": {
        "pattern": "^REPORTER_[A-Z0-9_]+$",
        "not": { "pattern": "(SECRET|PASSWORD)" }
      },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "secretEnv": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "key"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    }
  }
}
