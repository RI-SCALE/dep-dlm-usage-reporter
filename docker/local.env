# Settings for `make run` against the local stack (`make up`); test values only.
# Seed data sits on SEED_DAY (default yesterday), which is what REPORTER_DAY
# unset reports. Set REPORTER_DRY_RUN=false to POST to the ARGO stub.
REPORTER_RUCIO_HOST=http://localhost:8090
REPORTER_RUCIO_ACCOUNT=reporter
REPORTER_RUCIO_USERNAME=reporter
REPORTER_RUCIO_PASSWORD=secret
REPORTER_ARGO_ENDPOINT=http://localhost:8081
REPORTER_ARGO_METRIC_DEFINITION_ID=6afc3e7801adaea4c9c12777
REPORTER_ARGO_TOKEN_URL=http://localhost:8080/realms/dep/protocol/openid-connect/token
REPORTER_PROJECTS='{"RI-SCALE_ENES": {"installation_id": "6afaff4e947efcc6dea636e2", "client_id": "usage-reporter-enes", "client_secret_env": "REPORTER_SECRET_ENES"}, "RI-SCALE_EISCAT": {"installation_id": "6afaff4e947efcc6dea636e2", "client_id": "usage-reporter-enes", "client_secret_env": "REPORTER_SECRET_ENES"}}'
REPORTER_SECRET_ENES=enes-secret
